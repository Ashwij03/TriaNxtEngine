# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored — never commit secrets. All keys are optional in
# development (dev-only fallbacks exist in tria_engine/settings.py), but
# non-development environments MUST export them or Django refuses to boot.

# --- Django ---------------------------------------------------------------
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
# DJANGO_DB_ENGINE=django.db.backends.sqlite3
# DJANGO_DB_NAME=db.sqlite3
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=

# --- Billing / Razorpay (tria_engine/apps/billing) -------------------------
# Only RAZORPAY_KEY_ID is ever exposed to the browser (checkout widget);
# KEY_SECRET and WEBHOOK_SECRET stay strictly server-side.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Length of a paid period in days when a payment clears (default 30).
# BILLING_DEFAULT_PERIOD_DAYS=30
DATABASE_URL=postgres://user:password@host:5432/ctms
DJANGO_SECRET_KEY=
CTMS_ENCRYPTION_KEY=

# Copy to .env (same folder as docker-compose.yml) and adjust as needed.
# .env is only for local smoke-testing — real deployments pull these from
# AWS Secrets Manager (Step 9), not from a file.

DJANGO_SECRET_KEY=dev-only-not-for-production-change-me-immediately
CTMS_ENCRYPTION_KEY=dev-only-local-key-change-me
DJANGO_DB_NAME=tria_engine
DJANGO_DB_USER=tria_user
DJANGO_DB_PASSWORD=changeme_local_only